# Selenium tests related ENV vars file for the "tests" service container.
HOSTNAME_URL=${HOSTNAME_URL}
USE_MSLSX=${USE_MSLSX}
USE_NEW_PERM_SCREEN=${USE_NEW_PERM_SCREEN}
DJANGO_SETTINGS_MODULE=${DJANGO_SETTINGS_MODULE}
ACA_TOKEN_NAME=${ACA_TOKEN_NAME}
ACA_TOKEN_VALUE=${ACA_TOKEN_VALUE}

# Force to true in case false in .env
DB_MIGRATIONS=true
TARGET_ENV=local
FHIR_URL_V3=${FHIR_URL_V3:-https://prod-sbx.fhir.bfd.cmscloud.local}
