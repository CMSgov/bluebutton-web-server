#: templates/auth_base.html:56
msgid "Official government website"
msgstr "Sitio web oficial del gobierno"

#: templates/auth_base.html:84
msgid "An official website of the United States government"
msgstr "Un sitio oficial del Gobierno de Estados Unidos"

#: templates/auth_base.html:86
msgid "Here's how you know"
msgstr "Así es como usted puede verificarlo"

#: templates/auth_base.html:103
msgid "Cambiar a español"
msgstr "Change to English"

#: templates/auth_base.html:134
msgid "Official websites use .gov"
msgstr "Los sitios web oficiales usan .gov"

#: templates/auth_base.html:136
msgid "A <strong>.gov</strong> website belongs to an official "
"government organization in the United States."
msgstr "Un sitio web <strong>.gov</strong> pertenece a una organización "
"oficial del Gobierno de Estados Unidos."

#: templates/auth_base.html:164
msgid "Secure .gov websites use HTTPS"
msgstr "Los sitios web seguros .gov usan HTTPS"

#: templates/auth_base.html:167
msgid "A <strong>lock</strong> "
msgstr "Un <strong>candado</strong> "

#: templates/auth_base.html:181
msgid "or <strong>https://</strong> means you've safely connected to "
"the .gov website. Share sensitive information only on official, secure websites."
msgstr "o <strong>https://</strong> significa que usted se conectó "
"de forma segura a un sitio web .gov. Comparta información sensible "
"sólo en sitios web oficiales y seguros."

#: templates/auth_base.html:183
msgid ""
" means you've safely connected to the .gov website. Share sensitive "
"information only on official, secure websites."
msgstr ""
" significa que usted se conectó de forma segura a un sitio web .gov. "
"Comparta información sensible sólo en sitios web oficiales y seguros."

