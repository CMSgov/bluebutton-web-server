#!/bin/bash
# Run tofu plan (and optionally apply) across all BB2 services.
# Used by both tofu-plan and tofu-apply workflows.
#
# Follows the BB2 Fargate deploy order:
#   00-bootstrap → 01-config → ...
# See ops/services/RUNBOOK.md for the full manual procedure.
# test tofu
#
# Environment variables:
#   ENV     - Target environment (test, sandbox, prod)
#   APPLY   - Set to "true" to apply after plan (default: plan only)
#   SERVICE - Single service to plan/apply (default: all)
#
# NOTE: First-time bootstrap requires manual steps (GitHub connection
# approval, CodeBuild webhook import, SOPS seed creation) that cannot
# be automated. This script handles day-to-day plan/apply only.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
job_error=false
temp_plan_out=$(mktemp)
trap 'rm -f "$temp_plan_out" "${plan_log:-}" "${init_log:-}"' EXIT

# Derive parent_env for backend bucket selection (sandbox shares prod bucket)
parent_env="$ENV"
if [ "$parent_env" = "sandbox" ]; then parent_env="prod"; fi

# Export as TF_VAR so tofu picks it up for init and plan/apply
export TF_VAR_parent_env="$parent_env"

echo "=== BB2 tofu ${APPLY:+apply}${APPLY:-plan} for $ENV (parent_env=$parent_env) ==="

# Verify AWS credentials before starting
if ! aws sts get-caller-identity > /dev/null 2>&1; then
  echo "::error::AWS credentials not configured"
  exit 1
fi
echo "AWS credentials verified"

# Mask AWS account ID in GitHub Actions logs (BFD pattern)
account_id=$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)
if [[ -n "$account_id" ]]; then
  echo "::add-mask::$account_id"
fi

# error lines go to public GHA logs, account ids are masked but the rest of an ARN isn't
scrub_arns() { sed -E 's/arn:aws[a-z-]*:[^[:space:]"]+/<arn>/g'; }

# CloudWatch log group for full init/plan output (GHA only gets error lines)
cw_log_group="/bb/${ENV}/tofu-plan"
echo "View detailed init/plan output in CloudWatch:"
echo "  aws logs tail --since 1h --follow '$cw_log_group'"

# ship a log file to CloudWatch as one event. warns instead of failing, aws stderr stays hidden so ARNs don't leak
ship_to_cw() {
  local stream="$1" file="$2" events
  if aws logs create-log-group --log-group-name "$cw_log_group" > /dev/null 2>&1; then
    aws logs put-retention-policy --log-group-name "$cw_log_group" --retention-in-days 30 > /dev/null 2>&1 ||
      echo "::warning::couldn't set retention on $cw_log_group"
  fi
  # errors when the stream already exists (re-runs), that's fine
  aws logs create-log-stream --log-group-name "$cw_log_group" --log-stream-name "$stream" > /dev/null 2>&1 || true

  events=$(mktemp)
  if ! jq -Rs --arg ts "$(date -u +%s)000" '[{timestamp: ($ts | tonumber), message: .}]' "$file" > "$events" 2> /dev/null; then
    echo "::warning::couldn't build CloudWatch event for $stream"
  elif ! aws logs put-log-events --log-group-name "$cw_log_group" --log-stream-name "$stream" \
    --log-events "file://$events" > /dev/null 2>&1; then
    echo "::warning::couldn't ship $stream to CloudWatch (too big, or no logs perms?)"
  fi
  rm -f "$events"
}

# ============================================================
# Services deployed in strict dependency order:
#   00-bootstrap  → ECR, KMS, CodeBuild, OIDC
#   01-config     → SOPS → SSM parameters
#   10-cluster    → ECS Fargate cluster
#   20-microservices → ECS services, ALB, IAM, autoscaling
#   30-monitors   → Datadog monitors
#   40-dashboards → Datadog dashboards
# ============================================================
all_services=(00-bootstrap 01-config 10-cluster 20-microservices 30-monitors 40-dashboards)

if [[ -n "${SERVICE:-}" && "$SERVICE" != "all" ]]; then
  # Validate service name
  if [[ ! " ${all_services[*]} " =~ " ${SERVICE} " ]]; then
    echo "::error::Unknown service: $SERVICE. Must be one of: ${all_services[*]}"
    exit 1
  fi
  services=("$SERVICE")
else
  services=("${all_services[@]}")
fi

for service in "${services[@]}"; do
  dir="$repo_root/ops/services/$service"
  cd "$dir"

  echo "::group::$service ($ENV)"

  # Step 1: Init (keep output out of public logs, but show the error when it fails)
  init_log=$(mktemp)
  if ! tofu init -reconfigure -no-color > "$init_log" 2>&1; then
    { grep -A3 -E '^Error:' "$init_log" || tail -n 5 "$init_log"; } | scrub_arns >&2
    init_stream="${service}-init-${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-1}"
    ship_to_cw "$init_stream" "$init_log"
    echo "full init output: $cw_log_group / $init_stream"
    rm -f "$init_log"
    echo "::endgroup::"
    echo "::error::Error in tofu init for $service ($ENV)"
    if [ "${APPLY:-}" == "true" ]; then exit 1; fi
    job_error=true
    continue
  fi
  rm -f "$init_log"

  # Step 2: Select or create workspace
  tofu workspace select -or-create=true "$ENV" -no-color > /dev/null 2>&1

  # Step 3: Plan
  # Capture plan output to avoid leaking sensitive info (ARNs, IDs) in public repo logs
  tofu_warning=""
  tofu_error=""
  plan_exit=0
  plan_log=$(mktemp)
  tofu plan -detailed-exitcode -input=false -out "$temp_plan_out" -no-color > "$plan_log" 2>&1 || plan_exit=$?

  # Push full plan output to CloudWatch for private review
  ship_to_cw "${service}-${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-1}" "$plan_log"

  if [ "$plan_exit" -eq 0 ]; then
    echo "No changes planned for $service ($ENV)"
  elif [ "$plan_exit" -eq 2 ]; then
    # Only show the summary line, not the full resource details
    grep -E '^Plan:|^No changes' "$plan_log" || true
    tofu_warning="Changes planned for $service ($ENV)"
  else
    # Show only error lines, not the full plan output
    # Account IDs are auto-masked by ::add-mask:: above
    grep -E '^Error:|^  Error:|planning failed|exit status' "$plan_log" | scrub_arns >&2 || true
    tofu_error="Error in tofu plan for $service ($ENV)"
    if [ "${APPLY:-}" == "true" ]; then
      echo "::endgroup::"
      echo "::error::$tofu_error"
      exit 1
    fi
    job_error=true
  fi

  # Step 4: Apply (only when APPLY=true and changes were planned)
  if [[ -n "$tofu_warning" && "${APPLY:-}" == "true" ]]; then
    echo "Applying plan for $service ($ENV)..."
    if ! tofu apply -no-color -input=false "$temp_plan_out"; then
      echo "::endgroup::"
      echo "::error::Error in tofu apply for $service ($ENV)"
      exit 1
    fi

    # Step 5: Verify after apply
    case "$service" in
      10-cluster)
        echo "Verifying ECS cluster..."
        aws ecs describe-clusters --clusters "bb-${ENV}-cluster" \
          --query 'clusters[0].{name:clusterName,status:status}' \
          --output table 2>/dev/null || true
        ;;
      20-microservices)
        echo "Verifying ECS services..."
        aws ecs describe-services \
          --cluster "bb-${ENV}-cluster" \
          --services "bb-${ENV}-api-service" \
          --query 'services[0].{status:status,desired:desiredCount,running:runningCount}' \
          --output table 2>/dev/null || true
        ;;
      # TODO monitors and dashboards
    esac
  fi

  echo "::endgroup::"
  [ -n "$tofu_warning" ] && echo "::warning::$tofu_warning"
  [ -n "$tofu_error" ] && echo "::error::$tofu_error"
done

if [ "$job_error" == "true" ]; then
  exit 1
fi
